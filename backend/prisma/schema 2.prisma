// ==========================================================
// HỆ THỐNG QUẢN LÝ PHÒNG KHÁM ĐA KHOA (HIS + PATIENT PORTAL)
// Thiết kế theo chuẩn 3NF (Third Normal Form)
// - Không dư thừa dữ liệu
// - Không phụ thuộc bắc cầu
// - Tách bảng danh mục (Master Data)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: không đặt url trong schema
datasource db {
  provider = "mysql"
}

// ==========================================================
// ENUMS (Kiểu dữ liệu cố định giúp đảm bảo toàn vẹn dữ liệu)
// ==========================================================

enum Gender {
  NAM
  NU
  KHAC
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANKING
  QR
  EWALLET
}

enum StockType {
  IMPORT
  EXPORT
  ADJUST
}

// ==========================================================
// MASTER DATA (BẢNG DANH MỤC – ÍT THAY ĐỔI)
// ==========================================================

// ---------------------------
// Phân quyền hệ thống
// ---------------------------
model Role {
  id   Int    @id @default(autoincrement())
  name String @unique // ADMIN, BACSI, YTA...

  users User[]
}

// ---------------------------
// Khoa phòng
// ---------------------------
model Department {
  id   Int    @id @default(autoincrement())
  name String @unique

  staff Staff[]
}

// ---------------------------
// Nhóm dịch vụ (khám, xét nghiệm, phẫu thuật…)
// ---------------------------
model ServiceCategory {
  id   Int    @id @default(autoincrement())
  name String @unique

  services Service[]
}

// ---------------------------
// Dịch vụ cụ thể
// ---------------------------
model Service {
  id         Int     @id @default(autoincrement())
  name       String
  price      Decimal @db.Decimal(14, 2) // Chuẩn tiền tệ
  categoryId Int

  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  invoiceItems InvoiceItem[]

  @@index([categoryId])
}

// ---------------------------
// ICD10 – Mã bệnh chuẩn Bộ Y Tế
// ---------------------------
model ICD10 {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  diagnoses Diagnosis[]
}

// ---------------------------
// Giường bệnh nội trú
// ---------------------------
model Bed {
  id      Int    @id @default(autoincrement())
  bedCode String @unique

  admissions Admission[]
}

// ==========================================================
// AUTHENTICATION
// ==========================================================

model User {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
  roleId       Int

  role  Role   @relation(fields: [roleId], references: [id])
  staff Staff?
  patient Patient?

  createdAt DateTime @default(now())
}

// ==========================================================
// TỔ CHỨC NHÂN SỰ
// ==========================================================

model Staff {
  id           Int    @id @default(autoincrement())
  fullName     String
  departmentId Int
  userId       Int?   @unique // Quan hệ 1-1 với User

  department Department @relation(fields: [departmentId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])

  medicalRecords MedicalRecord[]
  appointments   Appointment[]
  surgeries      Surgery[]
}

// ==========================================================
// BỆNH NHÂN
// ==========================================================

model Patient {
  id          Int       @id @default(autoincrement())
  fullName    String
  dateOfBirth DateTime?
  gender      Gender
  phone       String?
  email       String?
  address     String?
  userId      Int?      @unique

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  admissions     Admission[]
  invoices       Invoice[]
  
  user           User?    @relation(fields: [userId], references: [id])
}

// ==========================================================
// ĐẶT LỊCH KHÁM
// ==========================================================

model Appointment {
  id        Int               @id @default(autoincrement())
  patientId Int
  doctorId  Int
  date      DateTime
  status    AppointmentStatus

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Staff   @relation(fields: [doctorId], references: [id])

  @@index([patientId])
}

// ==========================================================
// HỒ SƠ BỆNH ÁN (EMR)
// ==========================================================

model MedicalRecord {
  id        Int      @id @default(autoincrement())
  patientId Int
  doctorId  Int
  visitDate DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Staff   @relation(fields: [doctorId], references: [id])

  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  surgeries     Surgery[]
  invoice       Invoice?
}

// ==========================================================
// CHẨN ĐOÁN – TÁCH RIÊNG THEO 3NF
// ==========================================================

model Diagnosis {
  id       Int @id @default(autoincrement())
  recordId Int
  icd10Id  Int

  medicalRecord MedicalRecord @relation(fields: [recordId], references: [id])
  icd10         ICD10         @relation(fields: [icd10Id], references: [id])

  @@index([recordId])
}

// ==========================================================
// QUẢN LÝ NỘI TRÚ
// ==========================================================

model Admission {
  id           Int       @id @default(autoincrement())
  patientId    Int
  bedId        Int
  admittedAt   DateTime
  dischargedAt DateTime?

  patient Patient @relation(fields: [patientId], references: [id])
  bed     Bed     @relation(fields: [bedId], references: [id])
}

// ==========================================================
// PHẪU THUẬT
// ==========================================================

model Surgery {
  id        Int      @id @default(autoincrement())
  recordId  Int
  surgeonId Int
  name      String
  date      DateTime

  medicalRecord MedicalRecord @relation(fields: [recordId], references: [id])
  surgeon       Staff         @relation(fields: [surgeonId], references: [id])
}

// ==========================================================
// DƯỢC – KHO THUỐC
// ==========================================================

model Medicine {
  id   Int    @id @default(autoincrement())
  name String
  unit String

  stockMovements    StockMovement[]
  prescriptionItems PrescriptionItem[]
}

model StockMovement {
  id         Int       @id @default(autoincrement())
  medicineId Int
  type       StockType
  quantity   Int

  medicine Medicine @relation(fields: [medicineId], references: [id])
}

model Prescription {
  id       Int @id @default(autoincrement())
  recordId Int

  medicalRecord MedicalRecord      @relation(fields: [recordId], references: [id])
  items         PrescriptionItem[]
}

model PrescriptionItem {
  id             Int     @id @default(autoincrement())
  prescriptionId Int
  medicineId     Int
  quantity       Int
  dosage         String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  medicine     Medicine     @relation(fields: [medicineId], references: [id])
}

// ==========================================================
// VIỆN PHÍ
// ==========================================================

model Invoice {
  id        Int           @id @default(autoincrement())
  patientId Int
  recordId  Int           @unique
  status    InvoiceStatus
  createdAt DateTime      @default(now())

  patient Patient       @relation(fields: [patientId], references: [id])
  record  MedicalRecord @relation(fields: [recordId], references: [id])

  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  serviceId Int
  quantity  Int
  price     Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
}

model Payment {
  id        Int           @id @default(autoincrement())
  invoiceId Int
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  paidAt    DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}
